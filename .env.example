# Copy this file to .env and fill in your own values before running the app.

# Random long string used to sign login sessions (JWTs). Change this.
JWT_SECRET=replace-this-with-a-long-random-string

# The single admin account, created automatically the first time you run `npm run seed`.
ADMIN_EMAIL=rajashree@studio.com
ADMIN_PASSWORD=buffellow@123

# Port the server runs on
PORT=3000
